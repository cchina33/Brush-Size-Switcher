{
  "manifestVersion": 4,
  "id": "com.example.brushsizesw",
  "name": "BrushSizeSW",
  "version": "1.0.2",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "brushPanel",
      "label": "BrushSizeSW",
      "minimumSize": {
        "width": 80,
        "height": 100
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredFloatingSize": {
        "width": 220,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 220,
        "height": 420
      }
    }
  ]
}